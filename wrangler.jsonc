/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "edge-llm-relay",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-07",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"invocation_logs": true
		}
	},
	"placement": {  "mode": "smart" },
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Environment-specific configurations
	"env": {
		"baidu": {
			"name": "llmgateway",
			"placement": {
				"host": "qianfan.baidubce.com:443"
			},
			"vars": {
				"ROUTE_PREFIX": "baidu",
				"MODELS_ENABLED": "true",
				"UPSTREAM_BASE_URL": "https://qianfan.baidubce.com/v2/coding",
				"ANTHROPIC_UPSTREAM_BASE_URL": "https://qianfan.baidubce.com/anthropic/coding",
				"MODELS_JSON": "[{\"id\":\"ernie-4.5-turbo-20260402\"},{\"id\":\"minimax-m2.5\"},{\"id\":\"deepseek-v3.2\"},{\"id\":\"glm-5\"},{\"id\":\"kimi-k2.5\"}]",
				"UPSTREAM_CONTROL_AUTH": {
					"profiles": {
						"usage_default": {
							"cookies": {
								"bce-sessionid": "001de0bfa2553814f53af5cf3b21084f6d6",
								"bce-long-term-sessionid": "0015e9cd42448bb4225b27892c5e167de49"
							}
						},
						"resource_list": {
							"cookies": {
								"bce-sessionid": "001de0bfa2553814f53af5cf3b21084f6d6"
							}
						}
					}
				},
				"USAGE_QUERY_CONFIG": {
					"provider": "baidu",
					"request": {
						"url": "https://console.bce.baidu.com/api/qianfan/charge/codingPlan/resourceList",
						"method": "GET",
						"authProfile": "resource_list"
					}
				}
			}
		},
		"jd": {
			"name": "llmgateway-jd",
			"placement": {
				"host": "modelservice.jdcloud.com:443"
			},
			"vars": {
				"ROUTE_PREFIX": "jd",
				"MODELS_ENABLED": "true",
				"UPSTREAM_BASE_URL": "https://modelservice.jdcloud.com/coding/openai/v1",
				"ANTHROPIC_UPSTREAM_BASE_URL": "https://modelservice.jdcloud.com/coding/anthropic",
				"MODELS_JSON": "{\"DeepSeek-V3.2\":{\"name\":\"DeepSeek-V3.2\",\"limit\":{\"context\":128000,\"output\":64000}},\"GLM-5\":{\"name\":\"GLM-5\",\"limit\":{\"context\":200000,\"output\":32000}},\"GLM-4.7\":{\"name\":\"GLM-4.7\",\"limit\":{\"context\":200000,\"output\":128000}},\"MiniMax-M2.5\":{\"name\":\"MiniMax-M2.5\",\"limit\":{\"context\":200000,\"output\":128000}},\"Kimi-K2.5\":{\"name\":\"Kimi-K2.5\",\"limit\":{\"context\":256000,\"output\":32000}},\"Kimi-K2-Turbo\":{\"name\":\"Kimi-K2-Turbo\",\"limit\":{\"context\":256000,\"output\":32000}},\"Qwen3-Coder\":{\"name\":\"Qwen3-Coder\",\"limit\":{\"context\":64000,\"output\":8000}}}",
				"UPSTREAM_CONTROL_AUTH": {
					"profiles": {
						"active_plan": {
							"cookies": {
								"thor": "0D952D56EA09AD0761F2D6CE8190044D781247F08C84A2D34400E2DDBCCB4369B24D4249AD5C50870EFCCC07A804A50C3D023D4798E8CC3795FF03250B29D12A729FC1E925C5B0CB23A658914AC1BFFC4F57E70747A70012BA4FCDEFFB8E8DBBA9D4FF10337164F4DAA079AB06A3D02AD2C918C90082826DEE4995ABF4DCC2AE7B7459DF6BDF4F642E0C08A8E1C0AC5A"
							}
						}
					}
				},
				"USAGE_QUERY_CONFIG": {
					"provider": "jd",
					"request": {
						"url": "https://joybuilder-console.jdcloud.com/openApi/modelservice/describeUserActivePlan",
						"method": "GET",
						"authProfile": "active_plan"
					}
				}
			}
		},
		"zai": {
			"name": "llmgateway-zai",
			"placement": {
				"host": "api.z.ai:443"
			},
			"vars": {
				"ROUTE_PREFIX": "zai",
				"MODELS_ENABLED": "true",
				"UPSTREAM_BASE_URL": "https://api.z.ai/api/coding/paas/v4",
				"ANTHROPIC_UPSTREAM_BASE_URL": "https://api.z.ai/api/anthropic",
				"MODELS_JSON": [
					{ "id": "glm-5.1" },
					{ "id": "glm-5-turbo" },
					{ "id": "glm-5" },
					{ "id": "glm-4.7" }
				],
				"UPSTREAM_CONTROL_AUTH": {
					"profiles": {
						"quota_limit": {
							"headers": {
								"authorization": "Bearer eyJhbGciOiJIUzUxMiJ9..R_4kUImLndcZ91nM4qYR6Wa1J6dBnJjkSfPBroSnsPv7s3a0DgK2D94XH6Dx4EzaMBn7okzaM5w23m6nrlV60Q"
							}
						}
					}
				},
				"USAGE_QUERY_CONFIG": {
					"provider": "zai",
					"request": {
						"url": "https://api.z.ai/api/monitor/usage/quota/limit",
						"method": "GET",
						"authProfile": "quota_limit"
					}
				}
			}
		},
		"gateway": {
			"name": "llmgateway-cn-gateway",
			"vars": {
				"DEFAULT_PROVIDER_PREFIX": "baidu",
				"PROVIDERS_CONFIG": {
					"baidu": {
						"upstreamBaseUrl": "https://qianfan.baidubce.com/v2/coding",
						"anthropicUpstreamBaseUrl": "https://qianfan.baidubce.com/anthropic/coding",
						"models": [
							{ "id": "ernie-4.5-turbo-20260402" },
							{ "id": "minimax-m2.5" },
							{ "id": "deepseek-v3.2" },
							{ "id": "glm-5" },
							{ "id": "kimi-k2.5" }
						],
						"upstreamControlAuth": {
							"profiles": {
								"resource_list": {
									"cookies": {
										"bce-sessionid": "001de0bfa2553814f53af5cf3b21084f6d6"
									}
								}
							}
						},
						"usageQuery": {
							"provider": "baidu",
							"request": {
								"url": "https://console.bce.baidu.com/api/qianfan/charge/codingPlan/resourceList",
								"method": "GET",
								"authProfile": "resource_list"
							}
						}
					},
					"jd": {
						"upstreamBaseUrl": "https://modelservice.jdcloud.com/coding/openai/v1",
						"anthropicUpstreamBaseUrl": "https://modelservice.jdcloud.com/coding/anthropic",
						"models": {
							"DeepSeek-V3.2": {
								"name": "DeepSeek-V3.2",
								"limit": { "context": 128000, "output": 64000 }
							},
							"GLM-5": {
								"name": "GLM-5",
								"limit": { "context": 200000, "output": 32000 }
							},
							"GLM-4.7": {
								"name": "GLM-4.7",
								"limit": { "context": 200000, "output": 128000 }
							},
							"MiniMax-M2.5": {
								"name": "MiniMax-M2.5",
								"limit": { "context": 200000, "output": 128000 }
							},
							"Kimi-K2.5": {
								"name": "Kimi-K2.5",
								"limit": { "context": 256000, "output": 32000 }
							},
							"Kimi-K2-Turbo": {
								"name": "Kimi-K2-Turbo",
								"limit": { "context": 256000, "output": 32000 }
							},
							"Qwen3-Coder": {
								"name": "Qwen3-Coder",
								"limit": { "context": 64000, "output": 8000 }
							}
						},
						"upstreamControlAuth": {
							"profiles": {
								"active_plan": {
									"cookies": {
										"thor": "0D952D56EA09AD0761F2D6CE8190044D781247F08C84A2D34400E2DDBCCB4369B24D4249AD5C50870EFCCC07A804A50C3D023D4798E8CC3795FF03250B29D12A729FC1E925C5B0CB23A658914AC1BFFC4F57E70747A70012BA4FCDEFFB8E8DBBA9D4FF10337164F4DAA079AB06A3D02AD2C918C90082826DEE4995ABF4DCC2AE7B7459DF6BDF4F642E0C08A8E1C0AC5A"
									}
								}
							}
						},
						"usageQuery": {
							"provider": "jd",
							"request": {
								"url": "https://joybuilder-console.jdcloud.com/openApi/modelservice/describeUserActivePlan",
								"method": "GET",
								"authProfile": "active_plan"
							}
						}
					}
				}
			}
		},
		"minimax": {
			"name": "llmgateway-minimax",
			"placement": {
				"host": "api.minimaxi.com:443"
			},
			"vars": {
				"ROUTE_PREFIX": "minimax",
				"MODELS_ENABLED": "true",
				"UPSTREAM_BASE_URL": "https://api.minimaxi.com/v1",
				"ANTHROPIC_UPSTREAM_BASE_URL": "https://api.minimaxi.com/anthropic",
				"MODELS_JSON": "[{\"id\":\"minimax-m2.5\"},{\"id\":\"minimax-text-01\"}]"
			}
		}
	}
}
